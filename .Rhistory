set.seed(123)
n_sims <- 100000
results <- numeric(n_sims)
for (i in 1:n_sims) {
some_random_calculation <- rnorm(1, mean = 5, sd = 15)
results[i] <- some_random_calculation
}
summary_stats <- data.frame(
Mean = mean(results),
SD = sd(results),
Min = min(results),
Max = max(results),
Median = median(results),
Q1 = quantile(results, 0.25),
Q3 = quantile(results, 0.75),
Percentile_5 = quantile(results, 0.05),
Percentile_95 = quantile(results, 0.95),
kurtosis = moments::kurtosis(results),
skewness = moments::skewness(results),
)
