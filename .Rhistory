set.seed(2026)
n_sims <- 1000000
results <- numeric(n_sims)
args(rpois)
example("rpois")
set.seed(2026)
n_sims <- 1000000
results <- numeric(n_sims)
for ( i in 1:n_sims) {
non_complience <- rpois(1, lambda = 2)
results[i] <- non_complience
}
# Calculate the probability of 3 or more non-compliances
prob_3_or_more <- mean(results >= 3)
prob_3_or_more
