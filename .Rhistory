runs <- 100000 # runs is the number of simulation
sims <- rnorm(runs, mean = 1, sd = 10) # creates a vector of 100,000 random numbers from a normal distribution with mean 1 and standard deviation 10.
mc.intergral <- mean(sims >= 3 & sims <= 6) # calculates the proportion of values in sims that are between 3 and 6.
