n_sims <- 5000
n <- 61
sample_means <- numeric(n_sims)
for(i in 1:n_sims) {
vendor_scores <- rnorm(
n,
mean = 0.89,
sd = 12
)
sample_means[i] <- mean(vendor_scores)
}
